# SwiftPM build products
.build/
*.xcodeproj
.swiftpm/

# Assembled, signed application bundle produced by Scripts/build-app.sh.
# Rebuildable, and it carries a code signature tied to one machine's identity.
build/

# Signing material must never enter the repository. The development identity is
# imported into the login keychain instead; see the README's signing section.
*.p12
*.cer
*.p8

# Verification output
*.log
*.wav

.DS_Store
