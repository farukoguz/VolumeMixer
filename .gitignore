# macOS
.DS_Store

# SwiftPM / app build output
.build/
build/

# Icon generator intermediate; the .icns is the tracked artefact
VolumeMixer.iconset/

# SwiftPM build products
*.xcodeproj
.swiftpm/

# Scripts/build-app.sh assembles into build/ (ignored above). The prebuilt
# VolumeMixer.app at the repository root is tracked on purpose: it is the copy
# this repository ships, and the build script does not overwrite it.

# Signing material must never enter the repository. The development identity is
# imported into the login keychain instead; see the README's signing section.
*.p12
*.cer
*.p8

# Verification output
*.log
*.wav

